# Copy to .env.local. Never commit .env.local. Demo mode needs nothing but
# NEXT_PUBLIC_DEMO_MODE=true.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Platform-operator routes (/api/platform-admin/*). These act ACROSS tenants —
# reviewing a firm's rule pack before it may enforce — so no customer session
# can authorise them. Generate with `openssl rand -hex 32` and keep it separate
# from CRON_SECRET: leaking one must not grant the other.
PLATFORM_ADMIN_SECRET=
# --- Billing (Stripe) — src/lib/billing/** ---
# OFF by default. This app is a self-hosted console a firm runs for its own
# risk team, so there is nothing to sell it: leave this unset (or false) and
# /api/billing/checkout, /portal and /webhook all 404, and entitlement checks
# apply no plan ceiling. Set it to true only if you are running this as a
# hosted, subscription-billed service.
BILLING_ENABLED=false
#
# Everything below is read ONLY when BILLING_ENABLED=true. With the flag off
# these can stay empty — env validation does not ask for them.
#
# Secret key for creating checkout/portal sessions server-side (never the
# publishable key — nothing here runs client-side).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (Stripe dashboard -> Webhooks ->
# your endpoint -> "Signing secret"). This is the ONLY authentication the
# webhook route has; never leave it unset in production.
STRIPE_WEBHOOK_SECRET=
# Price ids for the three self-serve tiers (Stripe dashboard -> Products).
# Enterprise has no self-serve price — it is contact-sales only.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=
# --- Per-tenant connection secrets (src/lib/crypto/envelope.ts) ---
# Master key for envelope-encrypting provider credentials in the `connections`
# table. Generate with `openssl rand -base64 32` (must decode to 32 bytes —
# hex or base64 both accepted). Rotate by minting a new key AND bumping
# CURRENT_KEY_VERSION in envelope.ts; never commit this value or log it.
CONNECTIONS_MASTER_KEY=
# CORS headers are only emitted for this origin (unset = no CORS)
NEXT_PUBLIC_APP_URL=
# --- Outbound email (Resend is the standard per-client transport) ---
RESEND_API_KEY=
BRAND_EMAIL_FROM=
BRAND_EMAIL_SENDER_NAME=

# --- White-label branding (all optional; defaults = unbranded demo) ---
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_COMPANY=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_LOGO_URL=
NEXT_PUBLIC_BRAND_FAVICON_URL=
NEXT_PUBLIC_BRAND_ACCENT=
NEXT_PUBLIC_BRAND_NEUTRAL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TRADING_API_URL=
TRADING_API_KEY=

# --- Demo mode ---
# When true, the app is a fully public, mock-data sales demo: auth is bypassed
# and every data API returns mock data instead of hitting a live provider or
# Supabase (the admin client and platform facade throw in demo mode).
NEXT_PUBLIC_DEMO_MODE=true

# --- Trading-platform providers ---
# Set _ENABLED=true and supply credentials to take a provider live. MatchTrader
# (forex) and Tradovate (futures) have FULL live adapters; the rest are
# stub-and-ready (mock until their adapter's live block is implemented).
#
# Forex — MatchTrader (Broker API, LIVE adapter)
PROVIDER_MATCHTRADER_ENABLED=false
PROVIDER_MATCHTRADER_API_URL=        # per-deployment host, e.g. https://broker-api-demo.match-trader.com
PROVIDER_MATCHTRADER_API_KEY=        # Broker API token (sent raw in Authorization header)
PROVIDER_MATCHTRADER_SYSTEM_UUID=    # trading-server UUID (from GET /v1/offers if blank)
PROVIDER_MATCHTRADER_GROUPS=         # comma-separated account groups to enumerate
PROVIDER_DXTRADE_ENABLED=false
PROVIDER_DXTRADE_API_URL=
PROVIDER_DXTRADE_API_KEY=
PROVIDER_TRADELOCKER_ENABLED=false
PROVIDER_TRADELOCKER_API_URL=
PROVIDER_TRADELOCKER_API_KEY=
PROVIDER_CTRADER_ENABLED=false
PROVIDER_CTRADER_API_URL=
PROVIDER_CTRADER_API_KEY=
PROVIDER_METATRADER_ENABLED=false
PROVIDER_METATRADER_API_URL=
PROVIDER_METATRADER_API_KEY=
#
# Futures — Tradovate (LIVE adapter)
PROVIDER_TRADOVATE_ENABLED=false
PROVIDER_TRADOVATE_ENV=demo          # demo | live (or set API_URL to override the host)
PROVIDER_TRADOVATE_API_URL=          # optional host override
PROVIDER_TRADOVATE_NAME=             # Tradovate username
PROVIDER_TRADOVATE_PASSWORD=
PROVIDER_TRADOVATE_APP_ID=
PROVIDER_TRADOVATE_APP_VERSION=
PROVIDER_TRADOVATE_CID=              # API key client id
PROVIDER_TRADOVATE_SEC=              # API key secret
PROVIDER_TRADOVATE_DEVICE_ID=
PROVIDER_RITHMIC_ENABLED=false
PROVIDER_RITHMIC_API_URL=
PROVIDER_RITHMIC_API_KEY=
PROVIDER_TOPSTEPX_ENABLED=false
PROVIDER_TOPSTEPX_API_URL=
PROVIDER_TOPSTEPX_API_KEY=
PROVIDER_CQG_ENABLED=false
PROVIDER_CQG_API_URL=
PROVIDER_CQG_API_KEY=
PROVIDER_NINJATRADER_ENABLED=false
PROVIDER_NINJATRADER_API_URL=
PROVIDER_NINJATRADER_API_KEY=

# --- AI (src/lib/ai/**, src/lib/payouts/decision.ts) ---
# Powers the assistant's low-confidence intent fallback and payout-explanation
# polish. Demo mode never calls out even if this is set.
ANTHROPIC_API_KEY=

# --- Outbound email, legacy Gmail/nodemailer transport (src/lib/emails/gmail.ts) ---
# Used only when RESEND_API_KEY is unset. GMAIL_USER doubles as the From address.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Breach/violation notifications (src/lib/notify/webhook.ts) ---
# Fallback targets used when a tenant has no per-tenant
# RISK_WEBHOOK_URL_<SLUG> / RISK_SLACK_WEBHOOK_URL_<SLUG> configured.
RISK_WEBHOOK_URL=
RISK_SLACK_WEBHOOK_URL=

# --- Background agent feature flags ---
# Runs automated enforcement recommendations (src/lib/violations/worker.ts).
ENFORCEMENT_AGENT_ENABLED=false
# Runs the AI reviewer over queued deduction recommendations (src/lib/reviewer/agent.ts).
REVIEWER_AGENT_ENABLED=false

# --- Equity sampling (src/lib/ingest/sample.ts) ---
# How many accounts to sample concurrently per run. Default 5 if unset.
EQUITY_SAMPLE_CONCURRENCY=5
# How often (seconds) this is meant to run — informational; the real cadence
# is whatever schedule invokes the cron. Default 300 (5 minutes) if unset.
EQUITY_SAMPLE_INTERVAL_SECONDS=300
# How many days of equity snapshots to retain before pruning. Default 90 if unset.
EQUITY_SNAPSHOT_RETENTION_DAYS=90

# --- Support (src/lib/support/tickets.ts) ---
# Mailbox support tickets are filed to. Required outside demo mode — throws if unset.
SUPPORT_INBOX_EMAIL=
# Shown in the in-app help widget as the contact address.
NEXT_PUBLIC_SUPPORT_EMAIL=
